{
    "name": "HEIG-VD ProgServ3 Course Development Container",
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
            "moby": false
        },
        "ghcr.io/devcontainers/features/node:2": {
            // https://github.com/nodejs/release#release-schedule
            "version": "26"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "cweijan.vscode-database-client2",
                "esbenp.prettier-vscode",
                "laravel.vscode-laravel",
                "qwtel.sqlite-viewer",
                "shufo.vscode-blade-formatter"
            ]
        }
    },
    "forwardPorts": [5173, 8000, 8025],
    "portsAttributes": {
        "5173": {
            "label": "Vite Development Server"
        },
        "8000": {
            "label": "Laravel Development Server"
        },
        "8025": {
            "label": "Mailpit SMTP Server"
        }
    },
    // Execute the following command once the container is created
    "postCreateCommand": ".devcontainer/post-create.sh"
}
